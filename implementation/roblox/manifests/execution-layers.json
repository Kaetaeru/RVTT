{
  "schemaVersion": 1,
  "registryId": "rvtt-greenfield-execution-layers-v1",
  "authorityDocument": "implementation/roblox/GREENFIELD-EXECUTION-LAYERS.md",
  "architectureCoverageAuthority": "implementation/roblox/ARCHITECTURE-COVERAGE-POLICY.md",
  "architectureCoverageRegistry": "implementation/roblox/manifests/architecture-coverage.json",
  "moduleRegistry": "implementation/roblox/manifests/module-contracts.json",
  "canonicalSourceRoot": "greenfield/src",
  "canonicalTestRoot": "greenfield/tests",
  "policy": {
    "requireCoverageGateBeforePhase": true,
    "canonicalSourceAlwaysGitHub": true,
    "coreEngineRepositoryFirst": true,
    "studioExecutionRequiresCoreEngineComplete": true,
    "runtimeCoupledRunsOnlyAfterCoreEngineComplete": true,
    "studioIsRuntimeIntegrationWorkbench": true,
    "humanReviewIsForPresentationAndFeel": true,
    "runtimeCoupledStudioAuthoringAllowed": true,
    "runtimeCoupledMustCanonicalizeToGitHub": true,
    "doNotHumanTestPureEngineFunctions": true,
    "futureCompatibilityReviewRequiredAtCheckpointFreeze": true,
    "futureCapabilitiesConstrainArchitectureWithoutExpandingScope": true,
    "futureScenarioPressureSetRequired": true,
    "extensionSeamsRequired": true,
    "forbiddenShortcutsRequired": true,
    "uiShellSessionRequiredBeforePresentation": true,
    "htmlReferenceReviewRequiredForUiShell": true,
    "temporaryTestUiForbiddenAfterShell": true,
    "debugControlsMustUseProductShell": true,
    "debugControlsCannotBypassAuthority": true
  },
  "checkpointConcretization": {
    "E0_REPOSITORY_CORE_ENGINE": "AFTER_COVERAGE_AND_SYSTEM_BOUNDARY_FREEZE_BEFORE_SOURCE",
    "E1_ROBLOX_RUNTIME_INTEGRATION": "AFTER_CORE_ENGINE_COMPLETE_BEFORE_STUDIO",
    "E2_PRESENTATION_AND_FEEL": "AFTER_UI_SHELL_READY_JIT_ONE_USER_CHECKPOINT_AT_A_TIME"
  },
  "implementationSpecRequirements": {
    "scenarioSources": [
      "implementation/roblox/manifests/architecture-coverage.json",
      "implementation/roblox/manifests/architecture-scenarios.json"
    ],
    "futureCapabilitiesAre": "COMPATIBILITY_CONSTRAINTS_NOT_CURRENT_IMPLEMENTATION_SCOPE",
    "requiredAtCheckpointFreeze": [
      "currentDeliverable",
      "systemModuleScope",
      "stableFunctionScope",
      "authorityStateOwnership",
      "inputOutputContract",
      "currentScenarioWorkingSet",
      "futureConsumers",
      "futureScenarioPressureSet",
      "extensionSeams",
      "stableOwnershipAndIdentitySeams",
      "persistenceReconnectRollbackSeams",
      "observabilityFailureSeams",
      "forbiddenShortcuts",
      "explicitDeferredNonGoals",
      "automatedTests",
      "futureCompatibilityContractTests",
      "completionCondition"
    ],
    "freezeRejectedWhen": [
      "future consumer requires rewriting the checkpoint public contract instead of extending an explicit seam",
      "future scenario is ignored without an explicit non-applicability reason",
      "current feature owns state that belongs to a reusable shared authority boundary",
      "feature-specific helper direct store edit direct Remote client rule reconstruction or Studio-only truth bypasses a future shared boundary",
      "deferred future implementation is accidentally pulled into current source scope"
    ],
    "implementationEscalation": "ESCALATE_TO_PLANNING_ON_UNMODELED_FUTURE_CONFLICT"
  },
  "presentationPreparation": {
    "id": "U0_PRODUCT_UI_SHELL_SESSION",
    "isExecutionClass": false,
    "status": "WAITING_FOR_INTEGRATION_READY",
    "runsAfter": "INTEGRATION_READY",
    "runsBefore": "E2_PRESENTATION_AND_FEEL",
    "requiresStudio": true,
    "requiresCoreEngineComplete": true,
    "requiresIntegrationReady": true,
    "htmlReferenceDiscoveryAtSessionStart": true,
    "htmlReferencesAreDesignOnly": true,
    "htmlReferenceInventoryMustResolve": true,
    "unresolvedHtmlReferencePolicy": "BLOCK_U0_AND_ESCALATE_TO_PLANNING",
    "currentUiAuthorityRoot": "docs/remake/ui",
    "surfaceInventoryFreezeRequired": true,
    "designDistillationRequiredBeforeShellBuild": true,
    "productShellOnly": true,
    "featureLogicForbidden": true,
    "temporaryTestUiForbidden": true,
    "debugControlsInsideProductShellOnly": true,
    "debugControlsDevModeOnly": true,
    "debugControlsMayInjectProjectionFixtures": true,
    "gameplayDebugControlsMustUseRealCommandAuthorityPath": true,
    "debugControlsMayNotMutateAuthorityDirectly": true,
    "humanShellReviewRequired": true,
    "completionState": "UI_SHELL_READY",
    "requiredDesignNotes": [
      "referenceHtmlInventory",
      "surfaceInventory",
      "designPhilosophy",
      "informationArchitecture",
      "layoutPrinciples",
      "visualLanguage",
      "typographySpacingColorRoles",
      "componentPrimitives",
      "interactionStates",
      "loadingEmptyErrorDisabledStaleReconnectStates",
      "modalLayeringAndZOrder",
      "responsiveScaleAndAccessibility",
      "reducedMotionPolicy",
      "debugFixturePolicy",
      "robloxGuiMapping",
      "explicitUiNonGoals"
    ]
  },
  "executionClasses": {
    "CORE_ENGINE": {
      "authoring": "GITHUB_FIRST",
      "verification": ["REPOSITORY_AUTOMATED", "NEGATIVE_CASES"],
      "humanReview": false,
      "description": "Roblox-runtime-independent contracts, authority, state, command, projection policy, and domain logic after architecture coverage for the phase is ready."
    },
    "ROBLOX_RUNTIME_ENGINE": {
      "authoring": "STUDIO_MCP_AFTER_CORE_ENGINE_COMPLETE_GITHUB_CANONICAL",
      "verification": ["REPOSITORY_CONTRACT", "STUDIO_AUTOMATED_RUNTIME"],
      "humanReview": false,
      "description": "E1 engine behavior whose correctness depends on Roblox runtime geometry/services such as PathfindingService, raycasts, physics, collision, streaming, or DataStore adapters; Studio work begins only after all E0 core engine checkpoints complete."
    },
    "ROBLOX_INTEGRATION": {
      "authoring": "GITHUB_CANONICAL_STUDIO_INTEGRATION_AFTER_CORE_ENGINE_COMPLETE",
      "verification": ["STUDIO_AUTOMATED_INTEGRATION"],
      "humanReview": false,
      "description": "E1 Remote, Player, Instance, input, replica, composition, and lifecycle adapters that connect completed core engine code to Roblox runtime."
    },
    "PRESENTATION_FEEL": {
      "authoring": "STUDIO_MCP_AFTER_UI_SHELL_READY",
      "verification": ["STUDIO_SELF_CHECK", "HUMAN_ACCEPTANCE"],
      "humanReview": true,
      "description": "Visible presentation and player feel, wired into the accepted product UI shell and detailed just-in-time one user checkpoint at a time."
    }
  },
  "runtimeCoupledRule": {
    "class": "ROBLOX_RUNTIME_ENGINE",
    "coverageRequiredFirst": true,
    "coreEngineCompleteRequiredBeforeStudio": true,
    "canonicalSource": "GITHUB",
    "studioAuthoringAllowed": true,
    "studioAutomatedVerificationRequired": true,
    "humanAcceptanceRequiredOnlyForVisibleFeel": true,
    "examples": [
      "PathfindingService/navmesh result interpretation",
      "Workspace raycast and spatial-query adapters",
      "physics/collision-dependent resolution",
      "StreamingEnabled-sensitive runtime behavior",
      "DataStore/MemoryStore runtime adapters"
    ],
    "pathfindingExample": {
      "status": "PROVISIONAL_UNTIL_GAP_005_RESOLVED",
      "repositorySide": [
        "path request/response data contract",
        "movement permission and budget rules",
        "waypoint or plan normalization independent of Workspace",
        "failure/result semantics",
        "pure fallback/path policy if one exists"
      ],
      "studioSide": [
        "PathfindingService or approved runtime navigation provider invocation after CORE_ENGINE_COMPLETE",
        "actual navmesh/agent-parameter behavior",
        "obstacle and collision geometry",
        "raycast/spatial-provider behavior",
        "dynamic obstruction and recompute behavior"
      ],
      "humanSide": [
        "shown path readability when visible",
        "click-to-move responsiveness",
        "movement smoothness and perceived control"
      ]
    }
  },
  "phases": [
    {
      "id": "E0_REPOSITORY_CORE_ENGINE",
      "order": 0,
      "coveragePhaseGate": "E0_REPOSITORY_CORE_ENGINE",
      "status": "BLOCKED_BY_ARCHITECTURE_COVERAGE",
      "checkpointFreeze": "REQUIRED_BEFORE_FIRST_SOURCE",
      "studioAllowed": false,
      "modules": [
        "shared.protocol.command-envelope",
        "shared.protocol.projection-envelope",
        "shared.world.contract",
        "server.session.authority",
        "server.world.state",
        "server.authorization",
        "server.command.runtime",
        "server.projection",
        "server.domain.movement",
        "server.domain.exploration"
      ],
      "gate": [
        "architecture coverage phase has no open blockers",
        "E0 implementation checkpoints are concretized after system boundary freeze",
        "each E0 checkpoint includes future consumers scenario pressure extension seams forbidden shortcuts and deferred non-goals",
        "future compatibility review confirms future systems can extend shared seams without rewriting current public contracts",
        "contracts valid",
        "canonical source implemented in greenfield/src",
        "repository automated tests pass",
        "future compatibility contract tests pass",
        "negative authority/revision/disclosure/domain cases pass",
        "no Studio or MCP implementation was used to complete E0"
      ]
    },
    {
      "id": "E1_ROBLOX_RUNTIME_INTEGRATION",
      "order": 1,
      "coveragePhaseGate": "E1_ROBLOX_RUNTIME_INTEGRATION",
      "status": "WAITING_FOR_E0_AND_COVERAGE",
      "checkpointFreeze": "AFTER_CORE_ENGINE_COMPLETE_BEFORE_STUDIO",
      "studioAllowed": true,
      "modules": [
        "server.transport.command-gateway",
        "client.command",
        "server.transport.projection-gateway",
        "client.projection",
        "client.input.semantic-router",
        "client.world.system",
        "server.app",
        "server.bootstrap",
        "client.app",
        "client.bootstrap"
      ],
      "gate": [
        "architecture coverage phase has no open blockers",
        "all E0 core engine checkpoints are complete",
        "E1 Studio controller manager service adapter and harness checkpoints are concretized",
        "E1 checkpoints preserve the future consumers and extension seams frozen by E0",
        "greenfield Rojo build succeeds",
        "Studio/MCP runtime engine and integration tests pass",
        "Remote/Player/Instance/lifecycle boundaries behave correctly",
        "no human UX judgment required"
      ]
    },
    {
      "id": "E2_PRESENTATION_AND_FEEL",
      "order": 2,
      "coveragePhaseGate": "CHECKPOINT_SPECIFIC",
      "status": "WAITING_FOR_UI_SHELL_AND_CHECKPOINT_COVERAGE",
      "checkpointFreeze": "JIT_ONE_CHECKPOINT_AFTER_UI_SHELL_READY",
      "studioAllowed": true,
      "modules": [
        "client.world.selection",
        "client.world.presenter",
        "client.world.camera",
        "client.world.movement",
        "client.world.context"
      ],
      "gate": [
        "current checkpoint architecture coverage phase has no open blockers",
        "E0 and E1 are complete",
        "U0 product UI shell session completed with UI_SHELL_READY",
        "only the current user-facing checkpoint has been concretized",
        "current presentation checkpoint uses the real product shell instead of disposable test UI",
        "current presentation checkpoint does not reconstruct or bypass future shared engine authority",
        "current checkpoint is playable in Studio",
        "Codex Studio self-check passes",
        "visible behavior is handed to the user for acceptance"
      ]
    }
  ],
  "checkpointOrder": [
    "S1_SELECTION",
    "C1_CAMERA",
    "M1_MOVE",
    "X1_CONTEXT",
    "I1_INTERACTION"
  ],
  "moduleExecution": [
    {"moduleId":"shared.protocol.command-envelope","class":"CORE_ENGINE"},
    {"moduleId":"shared.protocol.projection-envelope","class":"CORE_ENGINE"},
    {"moduleId":"shared.world.contract","class":"CORE_ENGINE"},
    {"moduleId":"server.session.authority","class":"CORE_ENGINE"},
    {"moduleId":"server.world.state","class":"CORE_ENGINE"},
    {"moduleId":"server.authorization","class":"CORE_ENGINE"},
    {"moduleId":"server.command.runtime","class":"CORE_ENGINE"},
    {"moduleId":"server.projection","class":"CORE_ENGINE"},
    {"moduleId":"server.domain.movement","class":"CORE_ENGINE"},
    {"moduleId":"server.domain.exploration","class":"CORE_ENGINE"},
    {"moduleId":"server.transport.command-gateway","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"client.command","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"server.transport.projection-gateway","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"client.projection","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"client.input.semantic-router","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"client.world.system","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"server.app","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"server.bootstrap","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"client.app","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"client.bootstrap","class":"ROBLOX_INTEGRATION"},
    {"moduleId":"client.world.selection","class":"PRESENTATION_FEEL"},
    {"moduleId":"client.world.presenter","class":"PRESENTATION_FEEL"},
    {"moduleId":"client.world.camera","class":"PRESENTATION_FEEL"},
    {"moduleId":"client.world.movement","class":"PRESENTATION_FEEL"},
    {"moduleId":"client.world.context","class":"PRESENTATION_FEEL"}
  ]
}
