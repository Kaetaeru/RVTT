  "systemStages": [
    {
      "id": "G0_SHARED_CONTRACTS",
      "order": 0,
      "modulesRequired": [
        "shared.protocol.command-envelope",
        "shared.protocol.projection-envelope",
        "shared.world.contract"
      ],
      "gate": ["pure data contracts", "bounded validation", "stable ids and revision fields"]
    },
    {
      "id": "G1_SERVER_AUTHORITY_CORE",
      "order": 1,
      "modulesRequired": [
        "server.session.authority",
        "server.world.state",
        "server.authorization",
        "server.command.runtime"
      ],
      "gate": ["server-owned role/controller state", "authorization before mutation", "idempotency and stale-revision rejection"]
    },
    {
      "id": "G2_COMMAND_TRANSPORT",
      "order": 2,
      "modulesRequired": [
        "server.transport.command-gateway",
        "client.command"
      ],
      "gate": ["bounded and rate-limited remote input", "transport contains no gameplay authority"]
    },
    {
      "id": "G3_PROJECTION_PIPELINE",
      "order": 3,
      "modulesRequired": [
        "server.projection",
        "server.transport.projection-gateway",
        "client.projection"
      ],
      "gate": ["viewer-safe projection", "monotonic epoch and revision", "client projection is non-authoritative"]
    },
    {
      "id": "G4_CLIENT_WORLD_SHELL",
      "order": 4,
      "modulesRequired": [
        "client.input.semantic-router",
        "client.world.system"
      ],
      "gate": ["semantic input only", "world system owns lifecycle not gameplay rules"]
    },
    {
      "id": "G5_COMPOSITION_BOOT",
      "order": 5,
      "modulesRequired": [
        "server.app",
        "server.bootstrap",
        "client.app",
        "client.bootstrap"
      ],
      "gate": ["composition only", "clean boot and cleanup", "no DataStore during foundation"]
    }
  ],
