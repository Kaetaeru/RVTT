{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rvtt.local/schemas/actor-statblock.schema.json",
  "title": "RVTT D&D 2024 Actor Stat Block Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actorDefinitionId", "displayName", "rulesetId", "source", "size", "creatureType", "armorClass", "hitPoints", "speed", "abilities", "senses", "languages", "challenge", "proficiencyBonus", "traits", "actions", "bonusActions", "reactions", "legendaryActions", "token", "provenance"],
  "properties": {
    "schemaVersion": {"const": "rvtt.actor-statblock.v1"},
    "actorDefinitionId": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 120},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
    "rulesetId": {"const": "dnd5e-2024"},
    "locale": {"type": "string", "default": "ko-KR"},
    "source": {"$ref": "#/$defs/source"},
    "size": {"enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"]},
    "creatureType": {"type": "string", "minLength": 1, "maxLength": 80},
    "creatureTags": {"$ref": "#/$defs/stringList"},
    "alignment": {"type": ["string", "null"], "maxLength": 120},
    "armorClass": {"type": "object", "additionalProperties": false, "required": ["value", "description"], "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 99}, "description": {"type": ["string", "null"], "maxLength": 300}}},
    "hitPoints": {"type": "object", "additionalProperties": false, "required": ["average", "formula"], "properties": {"average": {"type": "integer", "minimum": 0}, "formula": {"$ref": "#/$defs/diceFormula"}}},
    "speed": {"type": "object", "additionalProperties": false, "required": ["walk"], "properties": {"walk": {"type": "integer", "minimum": 0}, "burrow": {"type": "integer", "minimum": 0}, "climb": {"type": "integer", "minimum": 0}, "fly": {"type": "integer", "minimum": 0}, "swim": {"type": "integer", "minimum": 0}, "hover": {"type": "boolean"}, "notes": {"type": ["string", "null"], "maxLength": 300}}},
    "abilities": {"type": "object", "additionalProperties": false, "required": ["str", "dex", "con", "int", "wis", "cha"], "properties": {"str": {"$ref": "#/$defs/abilityScore"}, "dex": {"$ref": "#/$defs/abilityScore"}, "con": {"$ref": "#/$defs/abilityScore"}, "int": {"$ref": "#/$defs/abilityScore"}, "wis": {"$ref": "#/$defs/abilityScore"}, "cha": {"$ref": "#/$defs/abilityScore"}}},
    "savingThrows": {"$ref": "#/$defs/namedBonuses"},
    "skills": {"$ref": "#/$defs/namedBonuses"},
    "damageVulnerabilities": {"$ref": "#/$defs/stringList"},
    "damageResistances": {"$ref": "#/$defs/stringList"},
    "damageImmunities": {"$ref": "#/$defs/stringList"},
    "conditionImmunities": {"$ref": "#/$defs/stringList"},
    "senses": {"type": "object", "additionalProperties": false, "required": ["passivePerception", "entries"], "properties": {"passivePerception": {"type": "integer", "minimum": 0}, "entries": {"$ref": "#/$defs/stringList"}}},
    "languages": {"$ref": "#/$defs/stringList"},
    "challenge": {"type": "object", "additionalProperties": false, "required": ["rating", "xp"], "properties": {"rating": {"type": "string", "pattern": "^(0|1/8|1/4|1/2|[1-9]|[12][0-9]|30)$"}, "xp": {"type": "integer", "minimum": 0}}},
    "proficiencyBonus": {"type": "integer", "minimum": 0, "maximum": 20},
    "initiativeBonus": {"type": "integer", "minimum": -20, "maximum": 40},
    "traits": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "bonusActions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "reactions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "legendaryActions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "spellcasting": {"type": ["object", "null"], "additionalProperties": false, "required": ["ability", "saveDc", "attackBonus", "entries"], "properties": {"ability": {"enum": ["int", "wis", "cha", "other"]}, "saveDc": {"type": "integer", "minimum": 1}, "attackBonus": {"type": "integer"}, "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "spellRefs"], "properties": {"label": {"type": "string", "minLength": 1}, "spellRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}}, "notes": {"type": ["string", "null"], "maxLength": 2000}}},
    "token": {"type": "object", "additionalProperties": false, "required": ["actorModelAssetId", "scale", "footprintFeet", "verticalOffsetStuds"], "properties": {"actorModelAssetId": {"type": ["string", "null"], "maxLength": 180}, "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 20}, "footprintFeet": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "verticalOffsetStuds": {"type": "number", "minimum": -100, "maximum": 100}, "presentationProfileId": {"type": ["string", "null"]}, "materialVariantId": {"type": ["string", "null"]}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["createdBy", "createdAt", "aiAssisted", "rightsStatus"], "properties": {"createdBy": {"type": "string", "minLength": 1}, "createdAt": {"type": "string", "format": "date-time"}, "aiAssisted": {"type": "boolean"}, "aiToolLabel": {"type": ["string", "null"]}, "rightsStatus": {"enum": ["project_owned", "licensed", "public_domain", "private_reference", "unknown_draft"]}, "sourceNote": {"type": ["string", "null"], "maxLength": 1000}}},
    "importWarnings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "notes": {"type": ["string", "null"], "maxLength": 2000}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["sourceType", "displayLabel"], "properties": {"sourceType": {"enum": ["rules_package", "campaign_homebrew", "imported_reference", "unknown_draft"]}, "displayLabel": {"type": "string", "minLength": 1}, "packageId": {"type": ["string", "null"]}, "definitionRef": {"type": ["string", "null"]}, "ruleAnchor": {"type": ["string", "null"]}, "sourceVersion": {"type": ["string", "null"]}, "contentHash": {"type": ["string", "null"]}}, "allOf": [{"if": {"properties": {"sourceType": {"const": "rules_package"}}}, "then": {"required": ["packageId", "definitionRef", "sourceVersion"]}}]},
    "abilityScore": {"type": "integer", "minimum": 1, "maximum": 60},
    "diceFormula": {"type": "string", "pattern": "^[0-9dD+\\- ()]+$", "minLength": 1, "maxLength": 80},
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 300}, "uniqueItems": true},
    "namedBonuses": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -20, "maximum": 60}},
    "feature": {"type": "object", "additionalProperties": false, "required": ["id", "name", "description"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1, "maxLength": 5000}, "ruleAnchor": {"type": ["string", "null"]}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "name", "economy", "description", "automation"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}, "name": {"type": "string", "minLength": 1}, "economy": {"enum": ["action", "bonus_action", "reaction", "legendary_action", "free", "passive", "special"]}, "description": {"type": "string", "minLength": 1, "maxLength": 7000}, "cost": {"type": ["integer", "null"], "minimum": 0}, "attack": {"type": ["object", "null"], "additionalProperties": false, "required": ["kind", "toHit", "target"], "properties": {"kind": {"enum": ["melee_weapon", "ranged_weapon", "melee_spell", "ranged_spell", "other"]}, "toHit": {"type": "integer"}, "target": {"type": "string", "minLength": 1}}}, "save": {"type": ["object", "null"], "additionalProperties": false, "required": ["ability", "dc", "onSuccess"], "properties": {"ability": {"enum": ["str", "dex", "con", "int", "wis", "cha"]}, "dc": {"type": "integer", "minimum": 1}, "onSuccess": {"type": "string", "minLength": 1}}}, "damage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["formula", "type"], "properties": {"formula": {"$ref": "#/$defs/diceFormula"}, "type": {"type": "string", "minLength": 1}, "notes": {"type": ["string", "null"]}}}, "range": {"type": ["object", "null"], "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["self", "touch", "melee", "ranged", "area", "special"]}, "normalFeet": {"type": ["integer", "null"], "minimum": 0}, "longFeet": {"type": ["integer", "null"], "minimum": 0}, "description": {"type": ["string", "null"]}}}, "recharge": {"type": ["string", "null"]}, "uses": {"type": ["string", "null"]}, "ruleAnchor": {"type": ["string", "null"]}, "automation": {"$ref": "#/$defs/automation"}}},
    "automation": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["manual", "trusted_recipe"]}, "recipeRef": {"type": ["string", "null"]}}, "allOf": [{"if": {"properties": {"mode": {"const": "trusted_recipe"}}}, "then": {"required": ["recipeRef"]}}, {"if": {"properties": {"mode": {"const": "manual"}}}, "then": {"properties": {"recipeRef": {"type": "null"}}}}]}
  }
}
}