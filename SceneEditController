local function getPlacementAssetsRoot()
	local replicatedStorage = game:GetService("ReplicatedStorage")
	local assetsRoot = replicatedStorage:FindFirstChild("Assets")
	if not assetsRoot then
		return nil
	end

	local worldEditAssets = assetsRoot:FindFirstChild("WorldEditAssets")
	if not worldEditAssets then
		worldEditAssets = Instance.new("Folder")
		worldEditAssets.Name = "WorldEditAssets"
		worldEditAssets.Parent = assetsRoot
	end

	for _, categoryName in ipairs({"Battlefields", "PropPrefabs", "TokenPrefabs", "BaseplateThemes", "Skyboxes"}) do
		if not worldEditAssets:FindFirstChild(categoryName) then
			local sourceCategory = assetsRoot:FindFirstChild(categoryName)
			if sourceCategory then
				local clone = sourceCategory:Clone()
				clone.Parent = worldEditAssets
			end
		end
	end

	return worldEditAssets
end

local function sortedChildren(folder)
	local children = folder:GetChildren()
	table.sort(children, function(a, b)
		return a.Name < b.Name
	end)
	return children
end

local function collectLeafAssetEntries(folder, prefix, entries)
	for _, child in ipairs(sortedChildren(folder)) do
		local relativePath = prefix ~= "" and (prefix .. " / " .. child.Name) or child.Name
		if child:IsA("Folder") then
			collectLeafAssetEntries(child, relativePath, entries)
		else
			entries[#entries + 1] = {
				label = relativePath,
				name = child.Name,
				className = child.ClassName,
				instance = child,
				searchKey = string.lower(relativePath .. " " .. child.Name .. " " .. child.ClassName),
			}
		end
	end
end

local function getCategoryDefinition(key)
	for _, definition in ipairs(placementBrowserCategories) do
		if definition.key == key then
			return definition
		end
	end
	return nil
end

local function clearScrollableList(scrollFrame)
	if not scrollFrame then
		return
	end
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("UIListLayout") or child:IsA("UIPadding") or child:IsA("UIGridLayout") then
			-- keep layout helpers
		else
			child:Destroy()
		end
	end
end

