local function ensureOverlay()
	if overlayGui and overlayGui.Parent and shellRefs then
		return overlayGui
	end

	if overlayGui then
		overlayGui:Destroy()
		overlayGui = nil
	end
	shellRefs = nil

	shellRefs = SceneEditShellBuilder.Create(PlayerGui)
	overlayGui = shellRefs.Gui
	rootFrame = shellRefs.Root
	sceneLabel = shellRefs.SceneLabel
	statusLabel = shellRefs.ModeLabel
	saveButton = shellRefs.SaveButton
	undoButton = shellRefs.UndoButton
	redoButton = shellRefs.RedoButton
