function SceneEditController:RequestSave()
	if SceneEditTransformController and SceneEditTransformController.ResolveBeforeSave then
		SceneEditTransformController:ResolveBeforeSave()
	end
	if not active then
		return true
	end
	if not DMEditSandboxController or not DMEditSandboxController.SaveToServer then
		return true
	end
	local saved = DMEditSandboxController:SaveToServer() == true
	if saved and SceneEditHistoryController then
		SceneEditHistoryController:MarkSaved()
	end
	return saved
end

function SceneEditController:Save()
	local ok = self:RequestSave()
	if not ok and NoticeManager and NoticeManager.Error then
		NoticeManager:Error("씬 저장에 실패했습니다.")
	end
	return ok
end

local function armPlacementStack()
	if SceneEditPlacementController and SceneEditPlacementController.SetActive then
		SceneEditPlacementController:SetActive(true)
	end
	if SceneEditVirtualGridController and SceneEditVirtualGridController.SetActive then
		SceneEditVirtualGridController:SetActive(true)
	end
	if SceneEditGhostController and SceneEditGhostController.SetActive then
		SceneEditGhostController:SetActive(true)
	end
	if SceneEditPlacementCommitController and SceneEditPlacementCommitController.SetActive then
		SceneEditPlacementCommitController:SetActive(true)
	end
	if SceneEditSelectionController and SceneEditSelectionController.SetActive then
		SceneEditSelectionController:SetActive(true)
	end
	if SceneEditTransformController and SceneEditTransformController.SetActive then
		SceneEditTransformController:SetActive(true)
	end
	if SceneEditWallToolController and SceneEditWallToolController.SetSceneEditActive then
		SceneEditWallToolController:SetSceneEditActive(true)
	end
end

function SceneEditController:EnterSceneEdit(sceneId)
	return self:Enter(sceneId)
end

function SceneEditController:ExitSceneEdit()
	return self:Exit()
end

function SceneEditController:Enter(sceneId)
	sceneId = tostring(sceneId or "")
	if sceneId == "" then
		return false
	end
	if transitioning then
		return false
	end
	if ClientStateManager and ClientStateManager.IsDM and not ClientStateManager:IsDM() then
		if NoticeManager and NoticeManager.Error then
			NoticeManager:Error("DM만 씬 편집을 열 수 있습니다.")
		end
		return false
	end
	if active and activeSceneId == sceneId then
		armPlacementStack()
		updateOverlay()
		return true
	end

	transitioning = true
	ensureOverlay()
	if WorldEditLibraryController and WorldEditLibraryController.Init then
		WorldEditLibraryController:Init({
			SceneEditController = SceneEditController,
			ObjectSelectController = ObjectSelectController,
			NoticeManager = NoticeManager,
			ClientStateManager = ClientStateManager,
			SceneEditPlacementController = SceneEditPlacementController,
			SceneEditHistoryController = SceneEditHistoryController,
			ShellRefs = shellRefs,
		})
	end
	updateOverlay()

	local ok = true
	local errMsg = nil

	if active and activeSceneId and activeSceneId ~= sceneId then
		if not self:RequestSave() then
			ok = false
			errMsg = "씬 저장에 실패했습니다."
		end
	end

	if ok then
		if not active then
			active = true
			SceneEditInputGate:SetActive(true, {
				KeepScreenGuis = {
					SceneEditUI = true,
				},
			})
			if DMToolbarController and DMToolbarController.SetSceneEditMode then
				DMToolbarController:SetSceneEditMode(true)
			end
			if TokenPlacementController and TokenPlacementController.StopPlacement then
				TokenPlacementController:StopPlacement()
			end
			if BattlefieldPlacementController and BattlefieldPlacementController.StopPlacement then
				BattlefieldPlacementController:StopPlacement()
			end
			if PropPlacementController and PropPlacementController.StopPlacement then
				PropPlacementController:StopPlacement()
			end
			if ObjectSelectController and ObjectSelectController.StartEditMode then
				ObjectSelectController:StartEditMode()
			end
			if CharacterActionBarController and CharacterActionBarController.ClosePanel then
				CharacterActionBarController:ClosePanel()
			end
			if overlayGui then
				overlayGui.Enabled = true
			end
		end

		-- Always (re)arm placement stack on enter/re-enter so ghost/grid stay live.
		armPlacementStack()

		activeSceneId = sceneId
		if SceneEditHistoryController then
			SceneEditHistoryController:BeginScene(activeSceneId)
		end
		if SceneEditSelectionController and SceneEditSelectionController.SetSceneContext then
			SceneEditSelectionController:SetSceneContext(activeSceneId)
		end
		if SceneEditVirtualGridController and SceneEditVirtualGridController.SetSceneContext then
			SceneEditVirtualGridController:SetSceneContext(activeSceneId)
		end
		if SceneEditTransformController and SceneEditTransformController.SetSceneContext then
			SceneEditTransformController:SetSceneContext(activeSceneId)
		end
		updateOverlay()

		local sandboxMatchesScene = DMEditSandboxController
			and DMEditSandboxController.IsActive
			and DMEditSandboxController:IsActive()
			and DMEditSandboxController.GetSceneId
			and tostring(DMEditSandboxController:GetSceneId()) == sceneId
		if not sandboxMatchesScene and RequestSceneCamera then
			-- The third argument explicitly requests a sandbox even for the live server scene.
			RequestSceneCamera:FireServer(sceneId, false, true)
		end
	end

	transitioning = false
	updateOverlay()

	if not ok then
		if NoticeManager and NoticeManager.Error and errMsg then
			NoticeManager:Error(errMsg)
		end
		return false
	end

	return true
end

function SceneEditController:Exit()
	if not active then
		return true
	end
	if transitioning then
		return false
	end

	transitioning = true
	updateOverlay()

	local currentServerSceneId = getCurrentServerSceneId()
	local saved = self:RequestSave()
	if not saved then
		transitioning = false
		updateOverlay()
		if NoticeManager and NoticeManager.Error then
			NoticeManager:Error("씬 저장에 실패해서 종료할 수 없습니다.")
		end
		return false
	end

	if SceneEditTransformController and SceneEditTransformController.SetActive then
		SceneEditTransformController:SetActive(false)
	end
	if SceneEditSelectionController and SceneEditSelectionController.SetActive then
		SceneEditSelectionController:SetActive(false)
	end
	if SceneEditWallToolController and SceneEditWallToolController.SetSceneEditActive then
		SceneEditWallToolController:SetSceneEditActive(false)
	end
	if SceneEditPlacementCommitController and SceneEditPlacementCommitController.SetActive then
		SceneEditPlacementCommitController:SetActive(false)
	end
	if SceneEditGhostController and SceneEditGhostController.SetActive then
		SceneEditGhostController:SetActive(false)
	end
	if SceneEditVirtualGridController and SceneEditVirtualGridController.SetActive then
		SceneEditVirtualGridController:SetActive(false)
	end
	if SceneEditPlacementController and SceneEditPlacementController.SetActive then
		SceneEditPlacementController:SetActive(false)
	end

	local targetServerSceneId = currentServerSceneId
	serverSceneId = targetServerSceneId
	if RequestSceneCamera then
		RequestSceneCamera:FireServer(targetServerSceneId, false)
	end

	if DMEditSandboxController and DMEditSandboxController.Exit then
		DMEditSandboxController:Exit()
	end
	if SceneEditHistoryController then
		SceneEditHistoryController:EndScene()
	end
	if ObjectSelectController and ObjectSelectController.StopEditMode then
		ObjectSelectController:StopEditMode()
	end
	SceneEditInputGate:SetActive(false)
	if DMToolbarController and DMToolbarController.SetSceneEditMode then
		DMToolbarController:SetSceneEditMode(false)
	end

	active = false
	activeSceneId = nil
	transitioning = false
	updateOverlay()
	if overlayGui then
		overlayGui.Enabled = false
	end
	return true
end

function SceneEditController:Init(dependencies)
	dependencies = dependencies or {}
	ClientStateManager = dependencies.ClientStateManager or ClientStateManager
	NoticeManager = dependencies.NoticeManager or NoticeManager
	DMToolbarController = dependencies.DMToolbarController or DMToolbarController
	serverSceneId = tostring(workspace:GetAttribute("ServerSceneId") or serverSceneId or "Default")
	DMEditSandboxController = dependencies.DMEditSandboxController or DMEditSandboxController
	TokenPlacementController = dependencies.TokenPlacementController or TokenPlacementController
	BattlefieldPlacementController = dependencies.BattlefieldPlacementController or BattlefieldPlacementController
	PropPlacementController = dependencies.PropPlacementController or PropPlacementController
	ObjectSelectController = dependencies.ObjectSelectController or ObjectSelectController
	CharacterActionBarController = dependencies.CharacterActionBarController or CharacterActionBarController
	SceneEditPlacementController = dependencies.SceneEditPlacementController or SceneEditPlacementController
	SceneEditVirtualGridController = dependencies.SceneEditVirtualGridController or SceneEditVirtualGridController
	SceneEditGhostController = dependencies.SceneEditGhostController or SceneEditGhostController
	SceneEditPlacementCommitController = dependencies.SceneEditPlacementCommitController or SceneEditPlacementCommitController
	SceneEditSelectionController = dependencies.SceneEditSelectionController or SceneEditSelectionController
	SceneEditHistoryController = dependencies.SceneEditHistoryController or SceneEditHistoryController
	SceneEditTransformController = dependencies.SceneEditTransformController or SceneEditTransformController
	if initialized then
		return
	end
	initialized = true
	if SceneEditHistoryController and SceneEditHistoryController.HistoryChanged then
		SceneEditHistoryController.HistoryChanged:Connect(function()
			updateOverlay()
		end)
	end
	if SceneEditPlacementController and SceneEditPlacementController.PlacementChanged then
		SceneEditPlacementController.PlacementChanged:Connect(function(selection)
			if not selection then
				browserSelection = nil
				browserSelectedCategoryKey = nil
			end
		end)
	end
	ensureOverlay()
	if WorldEditLibraryController and WorldEditLibraryController.Init then
		WorldEditLibraryController:Init({
			SceneEditController = SceneEditController,
			ObjectSelectController = ObjectSelectController,
			NoticeManager = NoticeManager,
			ClientStateManager = ClientStateManager,
			SceneEditPlacementController = SceneEditPlacementController,
			SceneEditHistoryController = SceneEditHistoryController,
			ShellRefs = shellRefs,
		})
	end
	if overlayGui then
		overlayGui.Enabled = false
	end
	updateOverlay()

	workspace:GetAttributeChangedSignal("SceneEditModeActive"):Connect(function()
		print("[SceneEditController] SceneEditModeActive changed ->", tostring(workspace:GetAttribute("SceneEditModeActive")))
	end)
	print("[SceneEditController] SceneEditModeActive initial =", tostring(workspace:GetAttribute("SceneEditModeActive")))

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not active then
			return
		end
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape then
			-- SceneEditSelectionController owns layered Escape cancellation.
			-- Never route Escape to editor exit; the top-bar button is authoritative.
			return
		end
		if input.KeyCode == Enum.KeyCode.S and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			SceneEditController:Save()
		end
	end)

	print("[SceneEditController] Initialized")
end

return SceneEditController
