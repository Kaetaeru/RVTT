local function hashToColor(text)
	local hash = 0
	for index = 1, #text do
		hash = (hash * 33 + text:byte(index)) % 360
	end
	return Color3.fromHSV(hash / 360, 0.35, 0.95)
end

local function createViewportPreview(viewport, sourceInstance)
	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport

	local camera = Instance.new("Camera")
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	viewport.Ambient = Color3.fromRGB(140, 145, 155)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(-0.4, -1, -0.4)

	local previewInstance = nil
	if sourceInstance:IsA("Sky") then
		local skyPart = Instance.new("Part")
		skyPart.Anchored = true
		skyPart.CanCollide = false
		skyPart.Shape = Enum.PartType.Ball
		skyPart.Size = Vector3.new(4, 4, 4)
		skyPart.Color = hashToColor(sourceInstance.Name)
		skyPart.Material = Enum.Material.SmoothPlastic
		skyPart.Parent = worldModel
		previewInstance = skyPart
	elseif sourceInstance:IsA("BasePart") or sourceInstance:IsA("Model") then
		local clone = sourceInstance:Clone()
		clone.Parent = worldModel
		previewInstance = clone
	else
		local fallback = Instance.new("Part")
		fallback.Anchored = true
		fallback.CanCollide = false
		fallback.Shape = Enum.PartType.Block
		fallback.Size = Vector3.new(3, 3, 3)
		fallback.Color = hashToColor(sourceInstance.Name)
		fallback.Material = Enum.Material.SmoothPlastic
		fallback.Parent = worldModel
		previewInstance = fallback
	end

	local center = Vector3.new(0, 0, 0)
	local size = Vector3.new(3, 3, 3)
	if previewInstance:IsA("Model") then
		local bboxCFrame, bboxSize = previewInstance:GetBoundingBox()
		center = bboxCFrame.Position
		size = bboxSize
	elseif previewInstance:IsA("BasePart") then
		center = previewInstance.Position
		size = previewInstance.Size
	end

	local extent = math.max(size.X, size.Y, size.Z, 1)
	local distance = math.max(6, extent * 1.65)
	camera.CFrame = CFrame.new(center + Vector3.new(distance, distance * 0.6, distance), center)

	return viewport
end

