local function updateBrowserInspector(selectedCategory, totalCount, filteredCount)
	if assetFrame then
		local assetTitle = assetFrame:FindFirstChild("AssetTitle")
		if assetTitle and assetTitle:IsA("TextLabel") then
			assetTitle.Text = string.format("에셋 (%d/%d)", filteredCount, totalCount)
		end
