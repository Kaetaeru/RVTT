	if categoryFrame then
		local categoryTitle = categoryFrame:FindFirstChild("CategoryTitle")
		if categoryTitle and categoryTitle:IsA("TextLabel") then
			categoryTitle.Text = "카테고리"
		end
	end
	if inspectorFrame then
		local placeholder = inspectorFrame:FindFirstChild("InspectorPlaceholder")
		if placeholder and placeholder:IsA("TextLabel") then
			placeholder.RichText = false
			if browserSelection and browserSelection.instance then
				placeholder.Text = string.format(
					"선택된 에셋\n%s\n%s\n%s",
					browserSelection.label,
					browserSelection.className,
					browserSelection.instance:GetFullName()
				)
			else
				placeholder.Text = "에셋을 선택하세요."
			end
		end
	end
end

function SceneEditController:GetSelectedPlacementAsset()
	if browserSelection then
		return browserSelection.instance, browserSelection
	end
	return nil, nil
end

function SceneEditController:ClearSelectedPlacementAsset(reason)
	browserSelection = nil
	browserSelectedCategoryKey = nil
	if SceneEditPlacementController and SceneEditPlacementController.ClearPlacementAsset then
		return SceneEditPlacementController:ClearPlacementAsset(reason or "scene-controller-clear")
	end
	return false
end

function SceneEditController:ClearWallPreset(reason)
	if SceneEditWallToolController and SceneEditWallToolController.Clear then
		SceneEditWallToolController:Clear(reason or "scene-controller-clear")
		return true
	end
	return false
end

function SceneEditController:SetWallPreset(selectionData)
	if typeof(selectionData) ~= "table" then
		self:ClearWallPreset("external-clear")
		return
	end
	self:ClearSelectedPlacementAsset("wall-preset-select")
	if SceneEditTransformController then
		SceneEditTransformController:SetTool("Select")
	end
	if SceneEditSelectionController and SceneEditSelectionController.ClearSelection then
		SceneEditSelectionController:ClearSelection()
	end
	if SceneEditWallToolController and SceneEditWallToolController.SetPreset then
		SceneEditWallToolController:SetPreset(selectionData)
	end
end

function SceneEditController:SetSelectedPlacementAsset(instance, selectionData)
	if instance == nil and selectionData == nil then
		self:ClearSelectedPlacementAsset("external-clear")
		return
	end

	self:ClearWallPreset("other-asset-select")

	selectionData = selectionData or {}
	browserSelection = {
		instance = instance,
		label = selectionData.name or (instance and instance.Name) or "Untitled",
		className = selectionData.className or (instance and instance.ClassName) or selectionData.kind or "Unknown",
		kind = selectionData.kind or (instance and instance.ClassName) or "Unknown",
		nodeId = selectionData.nodeId,
		branch = selectionData.branch,
	}
	browserSelectedCategoryKey = selectionData.branch or browserSelectedCategoryKey

	if SceneEditTransformController then
		SceneEditTransformController:SetTool("Select")
	end
	if SceneEditSelectionController and SceneEditSelectionController.ClearSelection then
		SceneEditSelectionController:ClearSelection()
	end
	if SceneEditPlacementController and SceneEditPlacementController.SetPlacementAsset then
		SceneEditPlacementController:SetPlacementAsset(instance, browserSelection)
	end
end

refreshAssetBrowser = function()
	ensureBrowserPanels()

	local assetsRoot = getPlacementAssetsRoot()
	if not assetsRoot then
		if inspectorFrame then
			local placeholder = inspectorFrame:FindFirstChild("InspectorPlaceholder")
			if placeholder and placeholder:IsA("TextLabel") then
				placeholder.Text = "ReplicatedStorage.Assets를 찾을 수 없습니다."
			end
		end
		return
	end

	local categoryRecords = {}
	for _, definition in ipairs(placementBrowserCategories) do
		local folder = assetsRoot:FindFirstChild(definition.key)
		local entries = {}
		if folder then
			collectLeafAssetEntries(folder, "", entries)
		end
		categoryRecords[#categoryRecords + 1] = {
			key = definition.key,
			label = definition.label,
			folder = folder,
			entries = entries,
			count = #entries,
		}
	end

	if #categoryRecords == 0 then
		if inspectorFrame then
			local placeholder = inspectorFrame:FindFirstChild("InspectorPlaceholder")
			if placeholder and placeholder:IsA("TextLabel") then
				placeholder.Text = "표시할 카테고리가 없습니다."
			end
		end
		return
	end

	local activeCategoryRecord = nil
	if browserSelectedCategoryKey then
		for _, record in ipairs(categoryRecords) do
			if record.key == browserSelectedCategoryKey then
				activeCategoryRecord = record
				break
			end
		end
	end
	if not activeCategoryRecord then
		for _, record in ipairs(categoryRecords) do
			if record.count > 0 then
				activeCategoryRecord = record
				browserSelectedCategoryKey = record.key
				break
			end
		end
	end
	if not activeCategoryRecord then
		activeCategoryRecord = categoryRecords[1]
		browserSelectedCategoryKey = activeCategoryRecord.key
	end

	clearScrollableList(browserCategoryScroll)
	clearScrollableList(browserAssetScroll)

	for index, record in ipairs(categoryRecords) do
		if browserCategoryScroll then
			local button = makeBrowserButton(browserCategoryScroll, string.format("%s (%d)", record.label, record.count), record.key == browserSelectedCategoryKey)
			button.LayoutOrder = index
			button.MouseButton1Click:Connect(function()
				browserSelectedCategoryKey = record.key
				refreshAssetBrowser()
			end)
		end
	end

	local searchText = ""
	if searchBox then
		searchText = string.lower(searchBox.Text or "")
	end

	local filteredEntries = {}
	for _, entry in ipairs(activeCategoryRecord.entries) do
		if searchText == "" or string.find(entry.searchKey, searchText, 1, true) then
			filteredEntries[#filteredEntries + 1] = entry
		end
	end

	if browserAssetScroll then
		if #filteredEntries == 0 then
			local emptyLabel = Instance.new("TextLabel")
			emptyLabel.Name = "EmptyLabel"
			emptyLabel.BackgroundTransparency = 1
			emptyLabel.Size = UDim2.new(1, -8, 0, 28)
			emptyLabel.Font = Enum.Font.Gotham
			emptyLabel.TextSize = 12
			emptyLabel.TextColor3 = Color3.fromRGB(158, 164, 174)
			emptyLabel.TextXAlignment = Enum.TextXAlignment.Left
			emptyLabel.Text = searchText ~= "" and "검색 결과가 없습니다." or "이 카테고리에 에셋이 없습니다."
			emptyLabel.Parent = browserAssetScroll
		else
			for index, entry in ipairs(filteredEntries) do
				local isSelected = browserSelection and browserSelection.instance == entry.instance
				local button = makeAssetBrowserButton(browserAssetScroll, entry, isSelected)
				button.LayoutOrder = index
				button.MouseButton1Click:Connect(function()
					browserSelection = entry
					browserSelectedCategoryKey = activeCategoryRecord.key
					refreshAssetBrowser()
				end)
			end
		end
	end

	updateBrowserInspector(activeCategoryRecord, activeCategoryRecord.count, #filteredEntries)
end

