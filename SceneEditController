		SceneEditController:Save()
	end)
	undoButton.MouseButton1Click:Connect(function()
		if SceneEditHistoryController then
			SceneEditHistoryController:Undo()
		end
	end)
	redoButton.MouseButton1Click:Connect(function()
		if SceneEditHistoryController then
			SceneEditHistoryController:Redo()
		end
	end)
	exitButton.MouseButton1Click:Connect(function()
		SceneEditController:ExitSceneEdit()
	end)

	return overlayGui
end

local function getCurrentServerSceneId()
	return tostring(workspace:GetAttribute("ServerSceneId") or serverSceneId or "Default")
end

local function updateOverlay()
	if sceneLabel then
		sceneLabel.Text = activeSceneId ~= nil and ("씬 편집 · " .. tostring(activeSceneId)) or "씬 편집"
	end
	if statusLabel then
		if transitioning then
			statusLabel.Text = "전환 중..."
		elseif active then
			statusLabel.Text = "DM 전용 편집 모드"
		else
			statusLabel.Text = "대기"
		end
	end
	if saveButton then
		local canSave = active == true and not transitioning
		saveButton.Visible = active == true
		saveButton.Active = canSave
		saveButton.AutoButtonColor = canSave
		saveButton.TextTransparency = canSave and 0 or 0.45
	end
	if undoButton then
		local canUndo = active == true and not transitioning
			and SceneEditHistoryController and SceneEditHistoryController:CanUndo()
		undoButton.Visible = active == true
		undoButton.Active = canUndo == true
		undoButton.AutoButtonColor = canUndo == true
		undoButton.TextTransparency = canUndo and 0 or 0.45
		undoButton.TextColor3 = canUndo and Color3.fromRGB(238, 240, 244) or Color3.fromRGB(151, 161, 176)
		undoButton.BackgroundColor3 = canUndo and Color3.fromRGB(57, 66, 80) or Color3.fromRGB(47, 51, 59)
	end
	if redoButton then
		local canRedo = active == true and not transitioning
			and SceneEditHistoryController and SceneEditHistoryController:CanRedo()
		redoButton.Visible = active == true
		redoButton.Active = canRedo == true
		redoButton.AutoButtonColor = canRedo == true
		redoButton.TextTransparency = canRedo and 0 or 0.45
		redoButton.TextColor3 = canRedo and Color3.fromRGB(238, 240, 244) or Color3.fromRGB(151, 161, 176)
		redoButton.BackgroundColor3 = canRedo and Color3.fromRGB(57, 66, 80) or Color3.fromRGB(47, 51, 59)
	end
	if exitButton then
		exitButton.Visible = active == true
		exitButton.Active = active == true and not transitioning
		exitButton.AutoButtonColor = active == true and not transitioning
	end
	if WorldEditLibraryController and WorldEditLibraryController.SetVisible then
		WorldEditLibraryController:SetVisible(active)
		if active and WorldEditLibraryController.Refresh then
			WorldEditLibraryController:Refresh()
		end
	end
end

